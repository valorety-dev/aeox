<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aeox.Core\Aeox.Core.csproj" />
    <ProjectReference Include="..\Aeox.UI\Aeox.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AeoxAim</AssemblyName>
    <RootNamespace>Aeox.Aim</RootNamespace>
    <Product>Aeox Aim</Product>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Valorety</Authors>
    <Company>Valorety</Company>
    <Copyright>Valorety</Copyright>
    <Description>Aim trainer with your real game sensitivity</Description>
    <ApplicationIcon>aeox.ico</ApplicationIcon>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Aeox.UI" />
    <Resource Include="aeox.ico" />
    <None Include="web\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
