<Window x:Class="Aeox.Scan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Aeox Scan"
        Icon="aeox.ico"
        Width="1240" Height="720" MinWidth="980" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="A&#x200A;E&#x200A;O&#x200A;X" FontFamily="{StaticResource BrandFont}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="  scan" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="24,24,24,0">
                    <TextBlock Text="your pc in 3d. the part that holds you back lights up, measured from your own matches." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <Button x:Name="RescanButton" Style="{StaticResource PrimaryButton}" Content="rescan" HorizontalAlignment="Left" Margin="0,22,0,0" Click="Rescan_Click" />
                    <Button x:Name="CardButton" Style="{StaticResource GhostButton}" Content="save card" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Card_Click" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,16,0,0" TextWrapping="Wrap" />
                    <TextBlock FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,22,0,0" TextWrapping="Wrap"
                               Text="hover a part for details. the card is a picture of your setup to share." />
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                    <TextBlock Text="made by valorety" FontSize="11.5" Foreground="{StaticResource FaintBrush}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
            </StackPanel>
            <wv2:WebView2 x:Name="View" Grid.Row="1" DefaultBackgroundColor="#0B0B0C" />
        </Grid>
    </Grid>
</Window>
