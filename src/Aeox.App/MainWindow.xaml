<Window x:Class="Aeox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aeox.App.ViewModels"
        xmlns:controls="clr-namespace:Aeox.App.Controls"
        Title="Aeox"
        Icon="Assets/aeox.ico"
        Width="1180" Height="740" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,6,16,30">
                <Image Source="Assets/logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="A&#x200A;E&#x200A;O&#x200A;X" FontFamily="{StaticResource BrandFont}" FontSize="14" VerticalAlignment="Center" Margin="12,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="12,0">
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE945;" Content="Performance" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Performance" />
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE7F4;" Content="Visuals" Command="{Binding NavigateCommand}" CommandParameter="Visuals" />
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE774;" Content="Network" Command="{Binding NavigateCommand}" CommandParameter="Network" />
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE950;" Content="System" Command="{Binding NavigateCommand}" CommandParameter="System" />
            </StackPanel>

            <RadioButton Grid.Row="3" Margin="12,0,12,16" Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE713;" Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        </Grid>

        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,52,40,32" Visibility="{Binding IsPerformancePage, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Performance" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="More FPS, less delay." FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,28" />

                    <ItemsControl ItemsSource="{Binding PerformanceTweaks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TweakItem}">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,17">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="{Binding Title}" FontSize="14" />
                                            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,52,40,32" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Hardware, locations and undo." FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,32" />

                    <TextBlock Text="HARDWARE" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding CpuText}" FontSize="13.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GpuText}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="LOCATIONS" Style="{StaticResource SectionLabel}" Margin="0,30,0,0" />
                    <TextBlock Text="{Binding ConfigText}" FontFamily="{StaticResource CodeFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DataText}" FontFamily="{StaticResource CodeFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="UNDO" Style="{StaticResource SectionLabel}" Margin="0,30,0,0" />
                    <TextBlock Text="{Binding BackupText}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <Button Style="{StaticResource GhostButton}" Content="Restore everything" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60" Visibility="{Binding IsComingSoonPage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Page}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Coming in the next build." FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,12,28,0">
                    <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="live" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,18,20,18">
                    <ItemsControl ItemsSource="{Binding Preview}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PreviewLine}">
                                <Grid x:Name="LineRoot" Margin="0,1.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" FontFamily="{StaticResource CodeFont}" FontSize="11.5" Foreground="#363A4C" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="1" Margin="14,0,0,0" FontFamily="{StaticResource CodeFont}" FontSize="12" TextWrapping="Wrap" controls:TokenText.Tokens="{Binding Tokens}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding GapBefore}" Value="True">
                                        <Setter TargetName="LineRoot" Property="Margin" Value="0,12,0,1.5" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,18,28,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusGlyph" Visibility="Collapsed" />
                                <TextBlock x:Name="StatusTitleText" Text="{Binding StatusTitle}" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="16,4,12,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Apply" Command="{Binding ApplyCommand}" VerticalAlignment="Center" Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
