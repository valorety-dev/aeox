<Window x:Class="Aeox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aeox.App.ViewModels"
        xmlns:controls="clr-namespace:Aeox.App.Controls"
        Title="Aeox"
        Icon="Assets/aeox.ico"
        Width="1180" Height="740" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <controls:PageIsConverter x:Key="PageIs" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        </Style>

        <DataTemplate DataType="{x:Type vm:TweakItem}">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="{Binding Title}" FontSize="14" />
                        <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChoiceItem}">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{StaticResource FaintBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="14" />
                        <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <ItemsControl ItemsSource="{Binding Options}" Margin="0,12,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChoiceOptionItem}">
                                    <RadioButton Style="{StaticResource Pill}" Content="{Binding Label}" GroupName="{Binding GroupName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,4,12,22">
                <Image Source="Assets/logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="A&#x200A;&#x200A;E&#x200A;&#x200A;O&#x200A;&#x200A;X" FontFamily="{StaticResource BrandFont}" FontSize="18" VerticalAlignment="Center" Margin="13,2,0,0" />
            </StackPanel>

            <Border Grid.Row="2" Margin="12,0,12,22" Padding="3" CornerRadius="10" Background="#10121B" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <UniformGrid Columns="2">
                    <RadioButton Style="{StaticResource Segment}" GroupName="Game" Content="Retrac" IsChecked="{Binding IsRetrac, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="Game" Content="Fortnite" IsChecked="{Binding IsFortnite, Mode=TwoWay}" />
                </UniformGrid>
            </Border>

            <StackPanel Grid.Row="3" Margin="12,0">
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE9F9;" Content="Checkup" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=Checkup}" CommandParameter="Checkup" />
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE9D2;" Content="Stats" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=Stats}" CommandParameter="Stats" />
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE945;" Content="Performance" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=Performance}" CommandParameter="Performance" />
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE7F4;" Content="Visuals" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=Visuals}" CommandParameter="Visuals" />
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE774;" Content="Network" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=Network}" CommandParameter="Network" />
                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE950;" Content="System" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=System}" CommandParameter="System" />
            </StackPanel>

            <RadioButton Grid.Row="4" Margin="12,0,12,16" Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE713;" Content="Settings" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=Settings}" CommandParameter="Settings" />
        </Grid>

        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,52,40,32" Visibility="{Binding IsTweakPage, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" DataContext="{Binding CurrentPage}">
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,28" />
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,52,40,32" Visibility="{Binding IsCheckupPage, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" DataContext="{Binding Checkup}">
                    <TextBlock Text="Checkup" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22" />
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CheckRow}">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,7,0,0" />
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}" FontSize="14" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="28" Padding="12,0" FontSize="12" Content="{Binding FixText}" Command="{Binding FixCommand}" VerticalAlignment="Center" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GhostButton}" Content="Scan again" Command="{Binding RunCommand}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,52,40,32" Visibility="{Binding IsStatsPage, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" DataContext="{Binding Stats}">
                    <TextBlock Text="Stats" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Headline}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,24" TextWrapping="Wrap" />
                    <controls:FpsChart Height="150" Values="{Binding Values}" Marks="{Binding Marks}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Width="9" Height="9" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="FPS per match" FontSize="11.5" Foreground="{StaticResource FaintBrush}" Margin="7,0,18,0" />
                        <Rectangle Width="10" Height="1" Stroke="{StaticResource AccentSoftBrush}" StrokeDashArray="2 2" VerticalAlignment="Center" />
                        <TextBlock Text="you applied a change" FontSize="11.5" Foreground="{StaticResource FaintBrush}" Margin="7,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Compare}" FontSize="13.5" Margin="0,24,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Bottleneck}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="RECENT MATCHES" Style="{StaticResource SectionLabel}" Margin="0,30,0,4" />
                    <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MatchRow}">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding When}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Fps}" FontSize="12.5" />
                                        <TextBlock Grid.Column="2" Text="{Binding Stutter}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Ping}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Limit}" FontSize="12.5" Foreground="{StaticResource FaintBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,52,40,32" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Hardware, locations and undo." FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,32" />

                    <TextBlock Text="GAME" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding GameText}" FontSize="13.5" Margin="0,10,0,30" TextWrapping="Wrap" />

                    <TextBlock Text="HARDWARE" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding CpuText}" FontSize="13.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GpuText}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DisplayText}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="LOCATIONS" Style="{StaticResource SectionLabel}" Margin="0,30,0,0" />
                    <TextBlock Text="{Binding ConfigText}" FontFamily="{StaticResource CodeFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DataText}" FontFamily="{StaticResource CodeFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="UNDO" Style="{StaticResource SectionLabel}" Margin="0,30,0,0" />
                    <TextBlock Text="{Binding BackupText}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <Button Style="{StaticResource GhostButton}" Content="Restore everything" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,52,40,32" Visibility="{Binding IsNetworkPage, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" DataContext="{Binding Network}">
                    <TextBlock Text="Network" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Find out where lag actually comes from." FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,32" />

                    <TextBlock Text="CONNECTION" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding ConnectionText}" FontSize="13.5" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,24,0,17" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Your router" FontSize="14" />
                                <TextBlock Text="{Binding RouterText}" FontFamily="{StaticResource CodeFont}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,17">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ServerLabel}" FontSize="14" />
                                <TextBlock Text="{Binding ServerText}" FontFamily="{StaticResource CodeFont}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Verdict}" FontSize="13.5" Margin="0,22,0,0" TextWrapping="Wrap" />
                    <Button Style="{StaticResource GhostButton}" Content="{Binding ButtonText}" Command="{Binding RunCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                    <TextBlock Text="Sends 30 pings to each. Registry “network tweaks” do nothing for Fortnite, so Aeox does not ship any." FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,18,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,12,28,0">
                    <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="live" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,18,20,18">
                    <ItemsControl ItemsSource="{Binding Preview}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PreviewLine}">
                                <Grid x:Name="LineRoot" Margin="0,1.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" FontFamily="{StaticResource CodeFont}" FontSize="11.5" Foreground="#363A4C" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="1" Margin="14,0,0,0" FontFamily="{StaticResource CodeFont}" FontSize="12" TextWrapping="Wrap" controls:TokenText.Tokens="{Binding Tokens}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding GapBefore}" Value="True">
                                        <Setter TargetName="LineRoot" Property="Margin" Value="0,12,0,1.5" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,18,28,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusGlyph" Visibility="Collapsed" />
                                <TextBlock x:Name="StatusTitleText" Text="{Binding StatusTitle}" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="16,4,12,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Apply" Command="{Binding ApplyCommand}" VerticalAlignment="Center" Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
