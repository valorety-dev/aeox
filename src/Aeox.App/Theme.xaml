<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowColor">#0D0F17</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="#0C0E15" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#10121B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#0A0C12" />
    <SolidColorBrush x:Key="CodeBrush" Color="#0B0D14" />
    <SolidColorBrush x:Key="CardActiveBrush" Color="#181A2E" />
    <SolidColorBrush x:Key="CardActiveBorderBrush" Color="#24274A" />
    <SolidColorBrush x:Key="LineBrush" Color="#191B26" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#272A3B" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#171A2C" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#121420" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5B5CF6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#8B8CFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECEEF5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C3C7D6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#878CA3" />
    <SolidColorBrush x:Key="FaintBrush" Color="#4E5368" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34C66A" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#7EE2A2" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F2A93B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F06A6A" />
    <SolidColorBrush x:Key="CodeKeywordBrush" Color="#7AA2FF" />
    <SolidColorBrush x:Key="CodeStringBrush" Color="#9BE38F" />
    <SolidColorBrush x:Key="CodeCommentBrush" Color="#6B7089" />
    <SolidColorBrush x:Key="CodeTextBrush" Color="#D7DAE6" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#2A2D3C" />
    <SolidColorBrush x:Key="ThumbOffBrush" Color="#9A9EB0" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="BrandFont">pack://application:,,,/Assets/Fonts/#Michroma</FontFamily>
    <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="11" Background="{StaticResource ToggleOffBrush}" />
                        <Border x:Name="Focus" CornerRadius="13" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource AccentSoftBrush}" Visibility="Collapsed" />
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource ThumbOffBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="#F4F5FF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,8" Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        <Border x:Name="Focus" CornerRadius="9" BorderThickness="1.5" BorderBrush="{StaticResource AccentSoftBrush}" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="15" Width="18" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavActiveBrush}" />
                            
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="14" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource LineStrongBrush}" />
                        <Border x:Name="Focus" CornerRadius="16" Margin="-3" BorderThickness="1.5" BorderBrush="{StaticResource AccentSoftBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="13,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#121420" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1C1E3A" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1C1F2E" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="9" Background="{StaticResource AccentBrush}" />
                        <Border x:Name="Focus" CornerRadius="11" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource AccentSoftBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#6C6DFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="#25273A" />
                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="9" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource LineStrongBrush}" />
                        <Border x:Name="Focus" CornerRadius="11" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource AccentSoftBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#171A28" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="4" Background="#232637" Margin="0,2" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
