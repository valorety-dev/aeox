<Window x:Class="Aeox.Driver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aeox.Driver"
        Title="Aeox Driver"
        Icon="aeox.ico"
        Width="1040" Height="680" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="A&#x200A;E&#x200A;O&#x200A;X" FontFamily="{StaticResource BrandFont}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="  driver" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="12,22,12,0">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="01" Content="overview" IsChecked="True" Checked="Nav_Checked" CommandParameter="Overview" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="02" Content="history" Checked="Nav_Checked" CommandParameter="History" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="03" Content="releases" Checked="Nav_Checked" CommandParameter="Releases" />
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                    <TextBlock Text="made by valorety" FontSize="11.5" Foreground="{StaticResource FaintBrush}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding GpuName}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="36,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="36,30,36,22">
                        <StackPanel>
                            <TextBlock><Run Text="01" Foreground="{StaticResource FaintBrush}" /><Run Text="  " /><Run Text="overview" FontWeight="Bold" /></TextBlock>
                            <TextBlock Text="your graphics driver, measured with your own matches." FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="36,28,36,0" MaxWidth="720" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="installed" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding Installed}" FontFamily="{StaticResource BrandFont}" FontSize="30" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding InstalledNote}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="newest from nvidia" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding Newest}" FontFamily="{StaticResource BrandFont}" FontSize="30" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding NewestNote}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Padding="20,18" Margin="0,32,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Verdict}" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding VerdictDetail}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" Visibility="{Binding HasPrimary, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="refresh" Command="{Binding RefreshCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,22,0,0" TextWrapping="Wrap"
                                   Text="downloads open nvidia's official page. to roll back, run the installer, pick custom install, then tick clean install." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsHistory, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="36,30,36,22">
                        <StackPanel>
                            <TextBlock><Run Text="02" Foreground="{StaticResource FaintBrush}" /><Run Text="  " /><Run Text="history" FontWeight="Bold" /></TextBlock>
                            <TextBlock Text="every driver you played on, from retrac and fortnite logs." FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="36,20,36,0" MaxWidth="760" HorizontalAlignment="Left">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="version" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="matches" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="2" Text="avg fps" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="3" Text="hitches/min" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="4" Text="crashes" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="5" Text="played" Style="{StaticResource Label}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HistoryRow}">
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="V" Text="{Binding Version}" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Matches}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Fps}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Stutter}" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Crashes}" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Seen}" Foreground="{StaticResource MutedBrush}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="V" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,18,0,0" TextWrapping="Wrap"
                                   Text="fortnite writes the driver version and fps into its logs. aeox keeps them, so this history grows with every session, even after the game deletes old logs." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsReleases, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="36,30,36,22">
                        <StackPanel>
                            <TextBlock><Run Text="03" Foreground="{StaticResource FaintBrush}" /><Run Text="  " /><Run Text="releases" FontWeight="Bold" /></TextBlock>
                            <TextBlock Text="{Binding ReleasesNote}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Releases}" Focusable="False" Margin="36,8,36,0" MaxWidth="760" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReleaseRow}">
                                <Border Style="{StaticResource Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Version}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Tag}" Foreground="{StaticResource SuccessBrush}" FontSize="12" Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Headline}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Height="26" Padding="10,0" FontSize="12" Content="notes" Command="{Binding NotesCommand}" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource GhostButton}" Height="26" Padding="10,0" FontSize="12" Content="download" Command="{Binding DownloadCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
